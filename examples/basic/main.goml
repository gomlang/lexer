package main;

use ecosystem::lexer;
use std::env;
use std::io;
use std::json;
use std::process;
use std::testing;

fn object(fields: Vec[(string, json::Value)]) -> json::Value {
    json::Value::Object(fields)
}

fn field(value: json::Value, name: string) -> Option[json::Value] {
    let fields = match value {
        Object(fields) => fields,
        _ => return Option::None,
    };
    for entry in fields {
        if entry.0 == name {
            return Option::Some(entry.1)
        }
    }
    Option::None
}

fn integer(value: json::Value) -> Option[isize] {
    json::as_int(value)
}

pub fn lex_case(value: json::Value) -> Result[json::Value, string] {
    let definitions = json::as_array(field(value, "rules").ok_or("missing rules")?).ok_or(
        "rules must be an array",
    )?;
    let source = json::as_string(field(value, "source").ok_or("missing source")?).ok_or(
        "source must be a string",
    )?;
    let rules: Vec[lexer::Rule[isize, (), string]] = Vec::new();
    for index in 0..definitions.len() {
        let definition = definitions[index];
        let pattern = json::as_string(field(definition, "pattern").ok_or("missing pattern")?).ok_or(
            "pattern must be a string",
        )?;
        let skip = field(definition, "skip").and_then(|value| json::as_bool(value)).unwrap_or(false);
        let callback = |_ctx: lexer::Context[()]| if skip {
            lexer::Action::Skip
        } else {
            lexer::Action::Emit(index)
        };
        let literal = field(definition, "literal").and_then(|value| json::as_bool(value)).unwrap_or(
            false,
        );
        let mut rule = if literal {
            lexer::Rule::literal(pattern, callback)
        } else {
            lexer::Rule::regex(pattern, callback)
        };
        if let Some(priority) = field(definition, "priority").and_then(|value| integer(value)) {
            rule = rule.with_priority(priority);
        }
        if field(definition, "ignore_case").and_then(|value| json::as_bool(value)).unwrap_or(false) {
            rule = rule.ignore_ascii_case();
        }
        if field(definition, "dot_all").and_then(|value| json::as_bool(value)).unwrap_or(false) {
            rule = rule.with_dot_all();
        }
        rules.push(rule);
    }
    let grammar = lexer::Grammar::compile(rules).map_err(|error| error.to_string())?;
    let lexer = grammar.lexer(source, ());
    let results: Vec[json::Value] = Vec::new();
    while let Some(result) = lexer.next() {
        let span = lexer.span();
        let fields: Vec[(string, json::Value)] = Vec::from_array(
            [
                ("start", json::Value::Number(span.start.to_string())),
                ("end", json::Value::Number(span.end.to_string())),
                ("slice", json::Value::String(lexer.slice())),
            ],
        );
        match result {
            Ok(rule) => fields.push(("rule", json::Value::Number(rule.to_string()))),
            Err(error) => {
                let message = match error {
                    Unexpected => "unexpected",
                    Ambiguous(_) => "ambiguous",
                    Callback(_) => "callback",
                    BudgetExceeded => "budget",
                };
                fields.push(("error", json::Value::String(message)));
            },
        }
        results.push(object(fields));
    }
    Result::Ok(json::Value::Array(results))
}

fn run_json() -> Result[(), string] {
    let input = io::read_stdin_to_string().map_err(|error| error.to_string())?;
    let cases = json::as_array(json::parse(input)?).ok_or("expected case array")?;
    let results: Vec[json::Value] = Vec::new();
    for value in cases {
        results.push(lex_case(value)?);
    }
    print(json::encode(json::Value::Array(results)));
    Result::Ok(())
}

fn main() -> () {
    if env::args().len() > 1 {
        if let Err(error) = run_json() {
            io::eprintln(error);
            process::exit(1);
        }
    } else {
        let rules: Vec[lexer::Rule[string, (), string]] = Vec::from_array(
            [
                lexer::Rule::token("let", "keyword"),
                lexer::Rule::regex("[a-z]+", |ctx| lexer::Action::Emit("name:" + ctx.slice())),
                lexer::Rule::regex("[0-9]+", |ctx| lexer::Action::Emit("number:" + ctx.slice())),
                lexer::Rule::token("=", "assign"),
                lexer::Rule::skip("\\s+"),
            ],
        );
        let grammar = testing::expect_ok(lexer::Grammar::compile(rules), "compile consumer grammar");
        let lexer = grammar.lexer("let answer = 42", ());
        let tokens: Vec[string] = Vec::new();
        for token in lexer {
            tokens.push(testing::expect_ok(token, "consumer token"));
        }
        testing::assert(
            tokens == Vec::from_array(["keyword", "name:answer", "assign", "number:42"]),
        );
        println("lexer consumer: ok");
    }
}
