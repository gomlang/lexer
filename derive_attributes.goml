package lexer;

#[comptime_derive]
fn attribute_option_index(attribute: MetaAttribute, key: string) -> isize {
    for index in 0..meta_attribute_argument_count(attribute) {
        let name = if meta_attribute_argument_kind(attribute, index) == "ident" {
            meta_attribute_argument_text(attribute, index)
        } else if meta_attribute_argument_kind(attribute, index) == "named" {
            meta_attribute_argument_name(attribute, index)
        } else {
            ""
        };
        if name == key {
            return index
        }
    }
    return -1
}

#[comptime_derive]
fn attribute_option(attribute: MetaAttribute, key: string, fallback: string) -> string {
    let index = attribute_option_index(attribute, key);
    if index < 0 {
        return fallback
    }
    if meta_attribute_argument_kind(attribute, index) == "ident" {
        "true"
    } else {
        meta_attribute_argument_text(attribute, index)
    }
}

#[comptime_derive]
fn validate_attribute(attribute: MetaAttribute, configuration: bool) -> () {
    if !meta_attribute_has_argument_list(attribute) {
        let _ = derive_error_at(attribute, "Lexer attributes require parentheses");
    }
    let count = meta_attribute_argument_count(attribute);
    if count == 0 {
        let _ = derive_error_at(attribute, "Lexer attribute cannot be empty");
    }
    for index in 0..count {
        let kind = meta_attribute_argument_kind(attribute, index);
        let value_kind = meta_attribute_argument_value_kind(attribute, index);
        let name = if kind == "ident" {
            meta_attribute_argument_text(attribute, index)
        } else if meta_attribute_argument_kind(attribute, index) == "named" {
            meta_attribute_argument_name(attribute, index)
        } else {
            ""
        };
        for previous in 0..index {
            let previous_name = if meta_attribute_argument_kind(attribute, previous) == "ident" {
                meta_attribute_argument_text(attribute, previous)
            } else if meta_attribute_argument_kind(attribute, previous) == "named" {
                meta_attribute_argument_name(attribute, previous)
            } else {
                ""
            };
            if name == previous_name {
                let _ = derive_error_at_argument(
                    attribute,
                    index,
                    "duplicate Lexer option or pattern: " + name,
                );
            }
        }
        if configuration {
            if kind != "named" || (name != "extras" && name != "error")
                || (value_kind != "ident" && value_kind != "path" && value_kind != "syntax") {
                let _ = derive_error_at_argument(
                    attribute,
                    index,
                    "lexer configuration accepts extras and error type paths",
                );
            }
            let _ = meta_attribute_argument_type(attribute, index);
        } else if index == 0 {
            if kind != "string" || meta_attribute_argument_text(attribute, index) == "" {
                let _ = derive_error_at_argument(
                    attribute,
                    index,
                    "Lexer rule requires a nonempty pattern string first",
                );
            }
        } else {
            let valid = (name == "callback" && kind == "named"
                && (value_kind == "ident" || value_kind == "path" || value_kind == "syntax"))
                || (name == "priority" && kind == "named"
                    && (value_kind == "string" || value_kind == "integer" || value_kind == "syntax"))
                || ((name == "ignore_ascii_case" || name == "dot_all") && kind == "ident");
            if !valid {
                let _ = derive_error_at_argument(
                    attribute,
                    index,
                    "unknown or invalid Lexer rule option: " + name,
                );
            }
            if name == "priority" {
                let _ = attribute_priority(attribute, index);
            }
            if meta_attribute_name(attribute) == "skip" && name == "callback" {
                let _ = derive_error_at_argument(
                    attribute,
                    index,
                    "skip rules cannot specify a callback",
                );
            }
        }
    }
}

#[comptime_derive]
fn attribute_priority(attribute: MetaAttribute, argument: isize) -> isize {
    let text = meta_attribute_argument_text(attribute, argument);
    if text == "" {
        let _ = derive_error_at_argument(
            attribute,
            argument,
            "Lexer priority must be a nonnegative decimal integer",
        );
    }
    let mut result = 0;
    for index in 0..text.byte_len() {
        let digit = text.byte_get(index);
        if digit < b'0' || digit > b'9' {
            let _ = derive_error_at_argument(
                attribute,
                argument,
                "Lexer priority must be a nonnegative decimal integer",
            );
        }
        let value = (digit - b'0').to_isize();
        if result > (9223372036854775807 - value) / 10 {
            let _ = derive_error_at_argument(attribute, argument, "Lexer priority exceeds isize");
        }
        result = result * 10 + value;
    }
    result
}
